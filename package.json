{
  "name": "behavior",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": "24.21.0",
    "pnpm": "12.5.1"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @behavior/frontend --filter @behavior/backend dev",
