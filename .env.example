# ルートの .env にコピーして使います。Docker Compose と Worker の設定です。
# フロントエンドの接続先は web/.env.example を参照してください。
WORKER_ALLOWED_ORIGINS=https://web.youdawanchi.workers.dev,http://localhost:3001,http://127.0.0.1:3001
WORKER_INITIAL_URL=https://en.wikipedia.org/wiki/Main_Page
WORKER_SESSION_ID=
WORKER_SESSION_AUDIENCE=browser-worker
# PEMの改行は \n として指定できます。署名用秘密鍵はWorkerへ渡さないでください。
WORKER_SESSION_PUBLIC_KEY=
WORKER_SESSION_MAX_TOKEN_TTL_SECONDS=300
WORKER_DISCONNECT_GRACE_SECONDS=600
WORKER_CPUS=4.0
WORKER_MEMORY_LIMIT=2g
WORKER_SHM_SIZE=1g
