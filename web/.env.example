# web/.env.local にコピーして使います。localhostでWorkerへ直接接続する場合だけ使います。
# 公開環境ではGitHub App経由で動的に接続するため、この値は使われません。
NEXT_PUBLIC_WORKER_WS_URL=ws://127.0.0.1:3000

# 以下はサーバー専用です。公開環境では.envではなくCloudflare Workers Secretsへ登録します。
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
WORKER_SESSION_PRIVATE_KEY=
