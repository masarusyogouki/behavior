# npm run setup:local が開発用の鍵とセッションIDを設定します。
# localはNext.jsのdevelopmentモード専用です。本番ではWORKER_CONNECTION_MODEを設定しません。
WORKER_CONNECTION_MODE=local
WORKER_LOCAL_WS_URL=ws://127.0.0.1:3000
WORKER_SESSION_ID=

# 以下はサーバー専用です。公開環境では.envではなくCloudflare Workers Secretsへ登録します。
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
WORKER_SESSION_PRIVATE_KEY=
# 32文字以上のランダムなbase64url文字列。初回接続時に画面へ入力します。
# npm run setup:local が生成します。本番はCloudflare Workers Secretsへ登録します。
BEHAVIOR_ACCESS_KEY=
